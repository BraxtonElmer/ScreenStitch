{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenStitch",
  "version": "0.1.0",
  "identifier": "io.github.braxtonelmer.screenstitch",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenStitch",
        "width": 1120,
        "height": 840,
        "minWidth": 880,
        "minHeight": 720,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
