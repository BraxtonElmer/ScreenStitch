{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenStitch",
  "mainBinaryName": "screenstitch-settings",
  "version": "0.2.0",
  "identifier": "io.github.braxtonelmer.screenstitch",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/prepare-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenStitch",
        "width": 1120,
        "height": 920,
        "minWidth": 880,
        "minHeight": 760,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/ScreenStitch"],
    "createUpdaterArtifacts": true,
    "publisher": "BraxtonElmer",
    "copyright": "Copyright (C) 2026 BraxtonElmer",
    "category": "Utility",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Lines up the cursor across monitors of different sizes",
    "longDescription": "ScreenStitch connects monitors by their real, physical size so the cursor crosses between screens of different resolutions and scaling exactly where you expect.",
    "homepage": "https://github.com/BraxtonElmer/ScreenStitch",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NzRDNUJDRDRERDE1M0YKUldRL0ZkM1V2TVYwMTNwc3BFOUlkdHZqc0RIM2c5VTZMRmxCVE5IS29SL3lYdGFYYUYwcVlJazgK",
      "endpoints": ["https://github.com/BraxtonElmer/ScreenStitch/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
